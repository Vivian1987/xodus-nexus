+/* Store ID, optionally SKU-qualified ("9XXXXXXXXXXX/0010"); out gets the product part. */
+static BOOL entitled_product_part( const char *text, char out[13] )
+{
+    if (!text || strlen(text) < 12) return FALSE;
+    memcpy(out, text, 12); out[12] = 0;
+    if (!entitled_id(out)) return FALSE;
+    return !text[12] || (text[12] == '/' && entitled_sku_id(text + 13));
+}
