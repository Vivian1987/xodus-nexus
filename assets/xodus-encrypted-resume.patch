+/// Files kept encrypted are stored as whole 4 KiB XTS pages.
+fn stored_length(content: &SegmentFile) -> u64 {
+    if content.keep_encrypted {
+        content.length.div_ceil(4096) * 4096
+    } else {
+        content.length
+    }
+}
+
+/// Matching package hashes do not prove the file on disk is complete.
+pub(super) fn is_stored(root: &Path, name: &str, content: &SegmentFile) -> bool {
+    target(root, name)
+        .and_then(fs::metadata)
+        .is_ok_and(|m| m.is_file() && m.len() == stored_length(content))
+}
+
+/// A completed encrypted file keeps its padded final page. A final page
+/// trimmed by an older resume cannot be decrypted at launch; such a file is
+/// downloaded again.
+pub(super) async fn prepare_resume(
+    file: &mut tokio::fs::File,
+    offset: u64,
+    content: &SegmentFile,
+) -> io::Result<u64> {
+    let stored = stored_length(content);
+    let offset = if offset == content.length && file.metadata().await?.len() < stored {
+        0
+    } else {
+        offset
+    };
+    prepare_output(file, if offset == content.length { stored } else { offset }).await?;
+    Ok(offset)
+}
+
+#[tokio::test]
+async fn streaming_encrypted_resume_keeps_final_page_and_refetches_trimmed_file() {
+    let content = |keep_encrypted| SegmentFile {
+        offset: 0,
+        length: 5000,
+        data_hashs: vec![],
+        keep_encrypted,
+    };
+    for (keep_encrypted, on_disk, offset, expected_offset, expected_len) in [
+        (true, 8192, 5000, 5000, 8192),
+        (true, 5000, 5000, 0, 0),
+        (false, 8192, 5000, 5000, 5000),
+        (true, 8192, 4096, 4096, 4096),
+    ] {
+        let root = tempfile::tempdir().unwrap();
+        let path = root.path().join("game.exe");
+        std::fs::write(&path, vec![7u8; on_disk]).unwrap();
+        let mut file = tokio::fs::OpenOptions::new()
+            .write(true)
+            .open(&path)
+            .await
+            .unwrap();
+        let offset = prepare_resume(&mut file, offset, &content(keep_encrypted))
+            .await
+            .unwrap();
+        assert_eq!(offset, expected_offset);
+        assert_eq!(std::fs::metadata(&path).unwrap().len(), expected_len);
+        assert_eq!(
+            is_stored(root.path(), "game.exe", &content(keep_encrypted)),
+            expected_len == stored_length(&content(keep_encrypted))
+        );
+    }
+    let root = tempfile::tempdir().unwrap();
+    assert!(!is_stored(root.path(), "missing.exe", &content(false)));
+}
