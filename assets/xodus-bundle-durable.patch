Subject: [PATCH] Support explicit Durable PC DLC after upstream bundle-membership fixes

Keep all upstream graph traversal restrictions and diagnostics.

diff --git a/crates/xodus-cli/src/package_plan.rs b/crates/xodus-cli/src/package_plan.rs
--- a/crates/xodus-cli/src/package_plan.rs
+++ b/crates/xodus-cli/src/package_plan.rs
@@ -40,7 +40,8 @@
     let localized = list(product, "LocalizedProperties").first().unwrap_or(&Value::Null);
     let title = text(localized, "ProductTitle");
     let title = if title.is_empty() { id.to_string() } else { title };
-    let kind = text(product, "ProductType");
+    let product_kind = text(product, "ProductType");
+    let kind = if product_kind == "Durable" { "GameAddOn".to_string() } else { product_kind.clone() };
     let mut choices: BTreeMap<(String, String, String), Choice> = BTreeMap::new();
     let mut bundled = HashSet::new();
     for availability in list(product, "DisplaySkuAvailabilities") {
@@ -53,8 +54,10 @@
                 .map(|v| text(v, "PlatformName")).filter(|s| !s.is_empty()).collect();
             let desktop = platforms.iter().any(|p| p == "Windows.Desktop");
             let format = text(package, "PackageFormat").to_uppercase();
+            let durable_package = product_kind == "Durable" && package["MainPackageFamilyNameForDlc"].as_str()
+                .is_some_and(|family| !family.is_empty() && family.len() <= 255 && family.bytes().all(|c| c.is_ascii_alphanumeric() || b"._-".contains(&c)));
             let supported = desktop && format == "MSIXVC"
-                && (kind == "Game" || kind == "GameAddOn")
+                && (product_kind == "Game" || product_kind == "GameAddOn" || durable_package)
                 && properties["IsTrial"].as_bool() != Some(true)
                 && properties["IsPreOrder"].as_bool() != Some(true);
             let platform = if desktop { "Windows.Desktop".to_string() } else { platforms.join(", ") };
@@ -168,6 +171,27 @@
     const ROOT: &str = "9AAAAAAAAAAA";
     const CHILD: &str = "9BBBBBBBBBBB";
     const CID: &str = "11111111-1111-4111-8111-111111111111";
+    #[test] fn durable_pc_dlc_requires_a_valid_base_family_and_explicit_selection() {
+        let mut child = package(CHILD,"Windows.Desktop","MSIXVC");
+        child["ProductType"] = json!("Durable");
+        let products = |child| BTreeMap::from([(ROOT.into(),bundle(ROOT,&[CHILD])),(CHILD.into(),child)]);
+        assert!(from_products(ROOT,&products(child.clone())).unwrap().select(Some(CID)).is_err());
+        child["DisplaySkuAvailabilities"][0]["Sku"]["Properties"]["Packages"][0]["MainPackageFamilyNameForDlc"] = json!("Example.Base_hash");
+        let plan = from_products(ROOT,&products(child.clone())).unwrap();
+        assert_eq!(plan.choices[0].kind,"GameAddOn");
+        assert!(plan.select(None).is_err());
+        assert_eq!(plan.select(Some(CID)).unwrap(),CID);
+        for invalid in ["", "../Other.Base", "https://invalid.example/base"] {
+            let mut invalid_child = child.clone();
+            invalid_child["DisplaySkuAvailabilities"][0]["Sku"]["Properties"]["Packages"][0]["MainPackageFamilyNameForDlc"] = json!(invalid);
+            assert!(from_products(ROOT,&products(invalid_child)).unwrap().select(Some(CID)).is_err());
+        }
+        for field in ["IsTrial", "IsPreOrder"] {
+            let mut excluded = child.clone();
+            excluded["DisplaySkuAvailabilities"][0]["Sku"]["Properties"][field] = json!(true);
+            assert!(from_products(ROOT,&products(excluded)).unwrap().select(Some(CID)).is_err());
+        }
+    }
     fn package(id: &str, platform: &str, format: &str) -> Value {
         json!({"ProductId":id,"ProductType":"Game","LocalizedProperties":[{"ProductTitle":"Test game"}],
             "DisplaySkuAvailabilities":[{"Sku":{"Properties":{"Packages":[{"ContentId":CID,"PackageFormat":format,"PlatformDependencies":[{"PlatformName":platform}]}]}}}]})
